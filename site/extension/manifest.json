{
  "manifest_version": 3,
  "name": "Trackobee Browser Sites",
  "description": "Tells the Trackobee agent on this computer which website (domain only) is in the active tab. Nothing is sent anywhere else.",
  "version": "1.0.0",
  "key": "",
  "minimum_chrome_version": "100",
  "permissions": ["tabs", "alarms"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
}
