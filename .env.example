# Copy to .env (chmod 600). Never commit .env.
# Supabase: Project Settings -> Database -> Connection string -> "Transaction pooler" (IPv4 compatible, port 6543). Use your DB password.
DATABASE_URL=postgresql://postgres.PROJECTREF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
# Public HTTPS address of this laptop (your Cloudflare Tunnel hostname)
TB_PUBLIC_URL=https://trackobee.example.com
TB_TRUST_PROXY=1
TB_SECURE_COOKIES=1
# 1 = people can REQUEST a workspace (you approve it in the owner console). 0 = hide the request form.
TB_ALLOW_SIGNUP=1
PORT=8090
TB_RETENTION_DAYS=60
# Keeps logins valid across restarts; setup.sh generates one.
TB_SECRET_KEY=
